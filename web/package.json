{
  "name": "pixsheaf-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "gen:api": "openapi-typescript ../api/openapi.yaml --output src/lib/api/schema.d.ts",
    "lint:api": "redocly lint ../api/openapi.yaml --config ../redocly.yaml",
    "gen:docs": "redocly bundle ../api/openapi.yaml --ext json --output node_modules/.cache/openapi.json && node scripts/api-docs.mjs node_modules/.cache/openapi.json ../docs/api.md"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@redocly/cli": "2.82.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.5",
    "eslint": "10.14.0",
    "eslint-plugin-svelte": "3.24.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.10.1",
    "prettier-plugin-svelte": "4.2.0",
    "svelte": "5.59.1",
    "svelte-check": "4.7.8",
    "tailwindcss": "4.3.5",
    "typescript": "~6.0.0",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8"
  }
}
