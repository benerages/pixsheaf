# Pixsheaf configuration. Copy to .env and adjust. All values shown are the
# defaults; unknown PIXSHEAF_* variables make the services refuse to start.
# Full reference: docs/configuration.md

# Image tag used by compose.yaml. Not a PIXSHEAF_* variable on purpose:
# the services reject unknown PIXSHEAF_* variables.
# IMAGE_TAG=latest

# Maximum size of one uploaded file, in MB (1-1024).
# PIXSHEAF_MAX_UPLOAD_MB=25

# Maximum number of files per job (1-10000).
# PIXSHEAF_MAX_FILES=50

# Maximum processing time per file (Go duration, 1s-30m).
# PIXSHEAF_JOB_TIMEOUT=60s

# Files processed in parallel across all clients (1-256). Each worker
# container also runs this many job processes at most.
# PIXSHEAF_MAX_CONCURRENCY=2

# Memory limit of one job process in MB (64-65536). Keep it below the
# worker container's mem_limit in compose.yaml.
# PIXSHEAF_JOB_MEMORY_MB=384

# Maximum size of all uploads of one job together, in MB (1-65536).
# PIXSHEAF_MAX_JOB_MB=250

# Maximum size of one processed file, in MB (1-256).
# PIXSHEAF_MAX_OUTPUT_MB=100

# Maximum width x height x frames of an upload (1-1000000000).
# PIXSHEAF_MAX_INPUT_PIXELS=50000000

# Maximum width x height of any intermediate or final image (1-1000000000).
# PIXSHEAF_MAX_OUTPUT_PIXELS=50000000

# Maximum frames of an animated GIF or WebP (1-1000).
# PIXSHEAF_MAX_FRAMES=300

# Maximum size of an image watermark, in KB (0-1024; 0 disables them).
# PIXSHEAF_MAX_WATERMARK_KB=512

# Files waiting for a worker; further uploads get 503 (1-100000).
# PIXSHEAF_MAX_QUEUE=100

# Jobs kept in memory at the same time (1-100000).
# PIXSHEAF_MAX_JOBS=200

# Lifetime of a job that is not downloaded (Go duration, 1m-24h).
# PIXSHEAF_JOB_TTL=15m

# Directory for uploads and results; must be on a tmpfs.
# PIXSHEAF_TMP_DIR=/tmp/pixsheaf

# All uploads and results together, in MB. Keep it below the size of the
# API's /tmp tmpfs in compose.yaml (512 MB).
# PIXSHEAF_MAX_STORE_MB=384

# Open jobs per client (1-100000) and API requests per client and minute
# (10-100000). Clients are told apart by IP address (ADR 0022).
# PIXSHEAF_MAX_JOBS_PER_CLIENT=10
# PIXSHEAF_REQUESTS_PER_MINUTE=300

# One uploaded ZIP archive: size in MB (at most half of
# PIXSHEAF_JOB_MEMORY_MB) and number of entries.
# PIXSHEAF_MAX_ARCHIVE_MB=100
# PIXSHEAF_MAX_ARCHIVE_ENTRIES=1000

# Comma-separated CIDR prefixes of reverse proxies whose X-Forwarded-For
# header is trusted. Empty: the header is ignored.
# PIXSHEAF_TRUSTED_PROXIES=

# debug, info, warn, or error.
# PIXSHEAF_LOG_LEVEL=info
