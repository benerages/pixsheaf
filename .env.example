# Pixsheaf configuration. Copy to .env and adjust. All values shown are the
# defaults; unknown PIXSHEAF_* variables make the services refuse to start.
# Full reference: docs/configuration.md

# Image tag used by compose.yaml. Not a PIXSHEAF_* variable on purpose:
# the services reject unknown PIXSHEAF_* variables.
# IMAGE_TAG=latest

# Maximum size of one uploaded file, in MB (1-1024).
# PIXSHEAF_MAX_UPLOAD_MB=25

# Maximum number of files per job (1-10000).
# PIXSHEAF_MAX_FILES=50

# Maximum processing time per file (Go duration, 1s-30m).
# PIXSHEAF_JOB_TIMEOUT=60s

# Files processed in parallel across all clients (1-256).
# PIXSHEAF_MAX_CONCURRENCY=2

# Memory limit of one job process in MB (64-65536). Keep it below the
# worker container's mem_limit in compose.yaml.
# PIXSHEAF_JOB_MEMORY_MB=384

# Comma-separated CIDR prefixes of reverse proxies whose X-Forwarded-For
# header is trusted. Empty: the header is ignored.
# PIXSHEAF_TRUSTED_PROXIES=

# debug, info, warn, or error.
# PIXSHEAF_LOG_LEVEL=info
